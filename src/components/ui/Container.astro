---
import { cn } from "@/lib/utils"
import type { HTMLAttributes } from "astro/types"

interface Props extends HTMLAttributes<"div"> {
  class?: string
  isTop?: boolean
}

const { class: className, isTop, ...props } = Astro.props
---

<div
  {...props}
  class={cn("p-5 max-w-7xl mx-auto", isTop && "pt-22", className)}
>
  <slot />
</div>
