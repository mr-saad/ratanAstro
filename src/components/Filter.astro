---
import { Icon } from "astro-icon/components"
import Button from "./ui/Button.astro"

const { categories } = Astro.props

const pathname = Astro.url.pathname
---

<script>
	const filterToggle = document.querySelector(".filterToggle"),
		filterBox = document.querySelector(".filterBox")

	filterToggle?.addEventListener("click", function () {
		filterBox?.classList.toggle("opacity-0")
		filterBox?.classList.toggle("pointer-events-none")
		filterBox?.classList.toggle("invisible")
	})
</script>

<div class="relative mb-2">
	<Button class="filterToggle"><Icon name="funnel" /></Button>
	<div
		class="filterBox pointer-events-none invisible absolute top-[110%] left-0 z-1 grid gap-2 rounded-md border bg-white p-2 opacity-0 transition-all"
	>
		<Button
			href="/products"
			variant={Astro.url.pathname === "/products" ? "default" : "secondary"}
		>
			All
		</Button>
		{
			categories.map((c: string) => {
				return (
					<Button
						href={"/products/" + c}
						variant={
							decodeURI(Astro.url.pathname) === `/products/${c}`
								? "default"
								: "secondary"
						}
					>
						{c}
					</Button>
				)
			})
		}
	</div>
</div>
