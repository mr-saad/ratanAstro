---
import Carousel from "@/components/Carousel.astro"
import HeaderImage from "@/components/HeaderImage.astro"
import Sections from "@/components/Sections.astro"
import Section from "@/components/ui/Container.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Store">
  <header
    class="relative isolate flex min-h-[95vh] items-center before:absolute before:h-full before:w-full before:bg-linear-to-r before:from-black/80 before:to-transparent"
  >
    <HeaderImage />
    <Section class="z-3 grow text-white">
      <h1 class="font-serif text-6xl tracking-tighter italic">Ratan Bandhej</h1>
      <p class="text-lg">One Place for all your Bandhani Needs.</p>
    </Section>
  </header>
  <Section>
    <h2 class="heading mt-5 mb-2">Fresh Crafts</h2>
    <Carousel />
  </Section>
  <Section>
    <Sections />
  </Section>
</Layout>
